{
    "manifest_version": 2,
    "default_locale": "en",
    "name": "__MSG_extensionName__",
    "version": "1.1.0",
    "description": "__MSG_extensionDescription__",
    "permissions": ["webRequest", "webRequestBlocking", "downloads", "storage", "tabs", "webNavigation", "<all_urls>"],
    "incognito": "spanning",
    "background": {
        "scripts": ["zip.js", "background.js"]
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "all_frames": true,
            "match_about_blank": true,
            "run_at": "document_idle"
        }
    ],
    "browser_action": {
        "default_title": "image-basket",
        "default_popup": "popup.html"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "image-basket@gpdir16",
            "strict_min_version": "142.0",
            "data_collection_permissions": { "required": ["none"] }
        }
    }
}
